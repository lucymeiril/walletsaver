# Database
DATABASE_URL=postgresql://user:password@localhost:5432/wallet_guardian

# 공공데이터 API Keys (https://data.go.kr 에서 발급)
KAMIS_API_KEY=your_kamis_api_key_here
KAMIS_API_ID=your_kamis_api_id_here
OPINET_API_KEY=your_opinet_api_key_here
KOSIS_API_KEY=your_kosis_api_key_here

# Naver API (https://developers.naver.com)
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Proxy (optional)
PROXY_LIST=

# Crawler Settings
CRAWL_DELAY_MIN=1.0
CRAWL_DELAY_MAX=5.0
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Image Storage
IMAGE_STORAGE_PATH=./storage/images
IMAGE_MAX_SIZE=1920
THUMBNAIL_SIZE=300

# API Server
API_HOST=0.0.0.0
API_PORT=8000
