{description}
"""

from __future__ import annotations

import logging
import re
from datetime import datetime
from typing import Optional

import requests
from bs4 import BeautifulSoup

from core.contracts.crawler import CrawlerContract
from core.models import (
    CrawlerInfo,
    CrawlerGroup,
    CrawlResult,
    CrawlStatus,
    HotdealPost,  # 또는 DiscountItem
)

# PluginInterface를 사용하면 라이프사이클 훅, 메트릭 등을 활용할 수 있다
# from plugins.plugin_interface import PluginInterface

logger = logging.getLogger(__name__)


class MyCrawler(CrawlerContract):
    """{display_name} 크롤러."""

    BASE_URL = "https://example.com"
    TARGET_URL = "https://example.com/deals"

    @property
    def info(self) -> CrawlerInfo:
        return CrawlerInfo(
            name="{name}",
            version="1.0.0",
            group=CrawlerGroup.HOTDEAL,  # 카테고리에 맞게 변경
            description="{description}",
            target_url=self.TARGET_URL,
            strategies=["requests"],
        )

    async def crawl(self) -> CrawlResult:
        """크롤링을 실행한다."""
        started_at = datetime.now()

        try:
            response = requests.get(self.TARGET_URL, timeout=15)
            response.raise_for_status()

            raw_data = response.text
            items = await self.parse(raw_data)
            valid_items = await self.validate(items)

            finished_at = datetime.now()

            return CrawlResult(
                status=CrawlStatus.SUCCESS,
                crawler_name=self.info.name,
                strategy_used="requests",
                items_count=len(valid_items),
                items=[item.model_dump(mode="json") for item in valid_items],
                started_at=started_at,
                finished_at=finished_at,
                duration_seconds=(finished_at - started_at).total_seconds(),
            )

        except Exception as e:
            logger.error(f"[{self.info.name}] 크롤링 실패: {e}", exc_info=True)
            return CrawlResult(
                status=CrawlStatus.FAILED,
                crawler_name=self.info.name,
                error_msg=str(e),
                started_at=started_at,
                finished_at=datetime.now(),
            )

    async def parse(self, raw_data: str) -> list[HotdealPost]:
        """HTML을 파싱하여 구조화된 데이터로 변환한다."""
        soup = BeautifulSoup(raw_data, "html.parser")
        items: list[HotdealPost] = []

        for el in soup.select(".deal-item"):
            title_el = el.select_one(".title")
            price_el = el.select_one(".price")

            if not title_el:
                continue

            title = title_el.get_text(strip=True)
            url = title_el.get("href", "")

            items.append(
                HotdealPost(
                    title=title,
                    url=url,
                    source_community="{name}",
                )
            )

        return items

    async def validate(self, items: list[HotdealPost]) -> list[HotdealPost]:
        """유효한 아이템만 필터링한다."""
        valid = []
        seen_urls: set[str] = set()

        for item in items:
            if item.url in seen_urls:
                continue
            seen_urls.add(item.url)

            if len(item.title) < 3:
                continue

            valid.append(item)

        return valid
