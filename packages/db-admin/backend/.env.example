# ─── DB Admin Backend Environment Variables ───
# Copy to .env and fill in real values. NEVER commit .env to git.

# Database (required for production)
DATABASE_URL=postgresql://walletsavior:<STRONG_PASSWORD>@db:5432/walletsavior

# Application
DEBUG=false
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=8002

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# API keys — comma-separated key:role pairs.
# Use the service role for crawler → db-admin ingestion calls.
SERVICE_API_KEYS=replace-with-crawler-key:service

# Rate Limiting
RATE_LIMIT_GLOBAL=200/minute
RATE_LIMIT_ADMIN=10/minute
RATE_LIMIT_DESTRUCTIVE=5/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_INGESTION=30/minute
RATE_LIMIT_STORAGE=memory://
# For production with Redis: RATE_LIMIT_STORAGE=redis://redis:6379/1

# Redis (optional — used for rate limit storage)
REDIS_URL=redis://localhost:6379/0

# Connection Pool (PostgreSQL only)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=30

# Logging
LOG_FORMAT=json        # "json" for production, "text" for development
LOG_LEVEL=INFO         # DEBUG, INFO, WARNING, ERROR

# Health Check Thresholds
HEALTH_DISK_WARN_MB=500
HEALTH_DISK_CRIT_MB=100
HEALTH_MEMORY_WARN_MB=512

# Disk Monitor Thresholds
DISK_WARN_MB=500
DISK_CRIT_MB=100
