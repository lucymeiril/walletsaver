# ─── DB Admin Backend Environment Variables ───
# Copy to .env and fill in values appropriate for your local machine.

# Local source database
DATABASE_URL=sqlite:///walletguardian.db
DEBUG=false
DB_ADMIN_HOST=127.0.0.1
DB_ADMIN_PORT=8002

# CORS — db-admin itself remains local-only
CORS_ALLOWED_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# API keys — comma-separated key:role pairs.
# Use the service role for crawler → db-admin ingestion calls.
SERVICE_API_KEYS=replace-with-crawler-key:service

# Derived read-only files consumed by web-api.
# start-all.ps1 fills these with absolute .walletsavior paths automatically.
# WALLETSAVIOR_PUBLIC_DB=C:\path\to\walletsaver\.walletsavior\public_snapshot.sqlite
# WALLETSAVIOR_EXTERNAL_HOTDEAL_DB=C:\path\to\walletsaver\.walletsavior\external_hotdeals.sqlite

# Optional deployment from local db-admin to the deployed web-api.
# Leave TOKEN empty to disable the remote management surface/client.
WALLETSAVIOR_REMOTE_ADMIN_URL=https://your-web-api.example.com
WALLETSAVIOR_REMOTE_ADMIN_TOKEN=
# Set false when web-api reads the same local snapshot files directly.
WALLETSAVIOR_REMOTE_SNAPSHOT_UPLOAD=true

# Rate Limiting
RATE_LIMIT_GLOBAL=200/minute
RATE_LIMIT_ADMIN=10/minute
RATE_LIMIT_DESTRUCTIVE=5/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_INGESTION=30/minute
RATE_LIMIT_STORAGE=memory://
# For production with Redis: RATE_LIMIT_STORAGE=redis://redis:6379/1

# Redis (optional — used for rate limit storage)
REDIS_URL=redis://localhost:6379/0

# Connection Pool (PostgreSQL only; ignored by the normal local SQLite setup)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=30

# Logging
LOG_FORMAT=json
LOG_LEVEL=INFO

# Health Check Thresholds
HEALTH_DISK_WARN_MB=500
HEALTH_DISK_CRIT_MB=100
HEALTH_MEMORY_WARN_MB=512

# Disk Monitor Thresholds
DISK_WARN_MB=500
DISK_CRIT_MB=100
