# Copy this file to .env and keep .env out of git.
# Provider configs store only this alias name (GOOGLE_API_KEY), never the value.
GOOGLE_API_KEY=replace-with-your-local-google-api-key
# Live smoke is opt-in because it consumes Google AI Studio quota.
# Without this opt-in, readiness output still reports whether the alias exists
# and which local .env path supplied it, but no provider request is made.
# WALLET_SAVIOR_LIVE_AI_SMOKE=1
# Prefer a higher-quota configured smoke model for repeated operator checks.
# AISTUDIO_SMOKE_MODEL=gemini-3.1-flash-lite-preview
