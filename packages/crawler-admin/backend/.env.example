# =============================================================================
# Crawler-Admin Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Required ---

# API authentication key
CRAWLER_ADMIN_API_KEY=

# db-admin working database. Raw export and weekly diff read current data from it.
# Crawler-admin does not store its weekly alert state in this DB.
# Local SQLite default is packages/db-admin/backend/walletguardian.db.
DB_ADMIN_DATABASE_URL=

# Enable/disable API key authentication (default: true)
REQUIRE_AUTH=true

# --- Current external data source ---

# OPINET official API key. Live fuel-price crawling is skipped when blank.
OPINET_API_KEY=
# Dedicated crawler-owned OPINET SQLite file. When blank, shared/core/fuel_store.py
# uses <repo>/data/opinet.db.
OPINET_DB_PATH=

# Optional direct crawler-admin -> deployed web-api OPINET snapshot publishing.
# Publishing is enabled only when BOTH values below are non-empty. Use the same
# token configured on the deployed web-api. db-admin is not involved in this path.
WALLETSAVIOR_REMOTE_ADMIN_URL=
WALLETSAVIOR_REMOTE_ADMIN_TOKEN=

# --- Optional ---

# Crawler-owned weekly alert state SQLite file.
# Default: packages/crawler-admin/backend/state/weekly_state.db
WALLETSAVIOR_WEEKLY_STATE_DB=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5174

# API server bind address
API_HOST=127.0.0.1
API_PORT=8000

# Proxy list used by crawler components that explicitly opt in.
PROXY_LIST=

# Crawler settings
CRAWL_DELAY_MIN=1.0
CRAWL_DELAY_MAX=5.0
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# Runtime limits
MAX_CONCURRENT_CRAWLS=5
CRAWL_CUMULATIVE_TIMEOUT=180
SSE_MAX_DURATION=1800

# Audit log rotation
AUDIT_LOG_MAX_BYTES=52428800
AUDIT_LOG_BACKUP_COUNT=10
