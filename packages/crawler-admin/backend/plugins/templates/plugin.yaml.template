# 플러그인 이름 (영문, 소문자, 하이픈 허용)
name: my-crawler

# 표시 이름 (한글 OK)
display_name: 내 크롤러

# 카테고리: mart, hotdeal, food, delivery, shopping, government, location, public
category: hotdeal

# 버전 (semver 형식: major.minor.patch)
version: 1.0.0

# 설명
description: "크롤러 설명을 여기에 작성한다"

# 작성자
author: walletSavior-team

# 크롤링 대상 설정
target:
  url: https://example.com/deals
  difficulty: 2          # 1(쉬움) ~ 5(어려움)
  strategy: requests     # 기본 전략: requests, cloudscraper, selenium, undetected, playwright

# 스케줄 설정
schedule:
  cron: "0 6 * * *"      # 매일 06:00
  retry_count: 3         # 실패 시 재시도 횟수
  retry_delay: 300       # 재시도 간격 (초)

# 출력 설정
output:
  model: HotdealPost     # CrawlResult에 담기는 모델: DiscountItem, HotdealPost
  required_fields:       # 필수 필드 목록
    - title
    - url

# 의존 플러그인 (없으면 빈 리스트)
dependencies: []
