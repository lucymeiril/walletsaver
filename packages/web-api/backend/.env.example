# Public web-api runtime configuration.
# Only web-api/web-frontend/shared need to be deployed; db-admin source is not
# part of the server runtime.

WALLETSAVIOR_CORS_ORIGINS=https://walletsavior.example.com

# Local-admin -> server management authentication.
# Use the same long random value in the LOCAL admin tool environments that are
# allowed to upload snapshots or perform remote moderation.
# If omitted, /api/admin/remote/* is disabled with HTTP 503.
WALLETSAVIOR_REMOTE_ADMIN_TOKEN=replace-with-long-random-token

# SQLite paths:
# - Leave these empty for local development. The code then uses repository-local
#   defaults, so a clone works regardless of where the repository itself lives.
# - On a deployed server, point them at ABSOLUTE paths on persistent storage.
#   The three snapshots are replaceable; the three writable DBs must survive
#   application redeploys.

# Replaceable read-only SQLite snapshots uploaded from local tools.
WALLETSAVIOR_PUBLIC_DB=
WALLETSAVIOR_EXTERNAL_HOTDEAL_DB=
# OPINET is produced by crawler-admin and read only by web-api. When blank,
# shared/core/fuel_store.py uses <repo>/data/opinet.db.
OPINET_DB_PATH=
WALLETSAVIOR_SNAPSHOT_MAX_BYTES=536870912

# Server-owned persistent SQLite databases.
WALLETSAVIOR_ACCOUNT_DB=
WALLETSAVIOR_BOARD_DB=
WALLETSAVIOR_INTERACTION_DB=
