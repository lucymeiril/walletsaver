# ── Website Backend Environment Variables ──

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/wallet_guardian

# --- API Server ---
WEBSITE_HOST=127.0.0.1
API_PORT=8000

# --- Debug / Environment ---
DEBUG=false
ENV=production

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 공공데이터 API Keys ---
OPINET_API_KEY=
KOSIS_API_KEY=

# --- Naver API ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# --- Rate Limiting ---
RATE_LIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Proxy ---
PROXY_LIST=

# --- Crawler ---
CRAWL_DELAY_MIN=1.0
CRAWL_DELAY_MAX=5.0
MAX_RETRIES=3
REQUEST_TIMEOUT=30

# --- Image Storage ---
IMAGE_STORAGE_PATH=storage/images
IMAGE_MAX_SIZE=1920
THUMBNAIL_SIZE=300

# --- Content Security Policy (optional overrides) ---
# CSP_POLICY=
# CSP_EXTRA_CONNECT_SRC=
# CSP_EXTRA_SCRIPT_SRC=

# --- Audit Logging ---
AUDIT_LOG_DIR=logs
